# Copy to .env (never commit .env) and fill in real values.
# Names only here; no real secrets in this file.

# --- Database (Neon). Use the DIRECT connection string (not the -pooler host) and sslmode=require ---
DB_URL=jdbc:postgresql://<neon-direct-host>/<dbname>?sslmode=require
DB_USERNAME=<neon-user>
DB_PASSWORD=<neon-password>

# --- Security ---
# Long random string, at least 32 characters. Generate your own.
JWT_SECRET=<generate-a-long-random-string>
JWT_EXPIRY_MINUTES=120

# --- First admin, created at startup only if no admin exists ---
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# --- CORS: comma-separated frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Render free tier has ~512 MB RAM ---
JAVA_TOOL_OPTIONS=-Xmx350m
