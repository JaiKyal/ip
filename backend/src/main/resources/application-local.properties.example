# Template for application-local.properties (which is git-ignored).
# Copy this file to application-local.properties. Activate with: $env:SPRING_PROFILES_ACTIVE = "local"
# DB_URL, DB_USERNAME and DB_PASSWORD come from environment variables (scripts/run-local.ps1 loads .env),
# so no secrets belong in either file. Put machine-specific overrides here, for example:

logging.level.com.example.shoppingcart=DEBUG
